# Copy this file to .env and fill in both secrets before starting the app.
# Never commit the real .env to version control.
#
# Generate values with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
API_KEY=

# SQLite (default, no extra setup):
DATABASE_URL=sqlite:///smartfacility.db

# MySQL example:
# DATABASE_URL=mysql+pymysql://sfm_user:REPLACE_WITH_PASSWORD@localhost:3306/smart_facility?charset=utf8mb4

FLASK_ENV=development
FLASK_DEBUG=1
ALERTS_PER_PAGE=20
LOG_LEVEL=INFO
